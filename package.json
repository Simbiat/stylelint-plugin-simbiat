{
    "name": "@simbiat/stylelint-plugin-simbiat",
    "version": "1.0.2",
    "description": "Custom Stylelint rules used in simbiat.eu project: require-attribute-i-flag.",
    "keywords": [
        "css",
        "css lint",
        "lint",
        "linter",
        "stylelint",
        "stylelint-plugin",
        "attribute-selector",
        "attribute flag",
        "case insensitive"
    ],
    "bugs": {
        "url": "https://github.com/simbiat/stylelint-plugin-simbiat/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/simbiat/stylelint-plugin-simbiat.git"
    },
    "license": "MIT",
    "author": {
        "name": "Dmitrii Kustov",
        "email": "support@simbiat.eu",
        "url": "https://www.simbiat.eu"
    },
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "default": "./dist/Plugin.mjs",
            "import": "./dist/Plugin.mjs",
            "types": "./dist/Plugin.d.mts"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/Plugin.mjs",
    "module": "./dist/Plugin.mjs",
    "types": "./dist/Plugin.d.mts",
    "files": [
        "dist"
    ],
    "scripts": {
        "prepare": "tsc"
    },
    "dependencies": {
        "postcss-selector-parser": ">=6.0.0"
    },
    "devDependencies": {
        "stylelint": ">=14.0.0"
    },
    "peerDependencies": {
        "stylelint": ">=14.0.0"
    },
    "engines": {
        "node": "^20.10.0 || >=21.0.0"
    }
}
